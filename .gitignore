# Dependencies
node_modules/

# Build output
dist/
build/
coverage/

# Environment files (secrets). Only the .env.example templates are committed.
.env
.env.*
*.env
!.env.example

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code personal settings
.claude/settings.local.json

# Backups written by the crawler one-offs (--apply=...). Keep them outside the
# project; this only stops one from being committed by mistake.
*backup*.json

# Test account logins (account.md): local only, never committed.
account.md
