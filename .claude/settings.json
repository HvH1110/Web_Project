{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)"
    ],
    "deny": [
      "Bash(git add .)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git commit -a*)",
      "Bash(git commit --all*)",
      "Bash(git commit --amend*)",
      "PowerShell(git add .)",
      "PowerShell(git add -A*)",
      "PowerShell(git add --all*)",
      "PowerShell(git commit -a*)",
      "PowerShell(git commit --all*)",
      "PowerShell(git commit --amend*)"
    ]
  }
}
