# Copy to .env and fill in. .env is gitignored; never commit real values.

# MongoDB Atlas connection string: the same cluster as the backend, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Only needed by `npm run crawl`. `npm run probe` works without it.
MONGODB_URI=

# Minimum delay between two requests to the same host, in milliseconds.
CRAWL_DELAY_MS=5000

# Cartier has ~1,600 tracked products per market on one host, so each run
# checks one slice and every product comes round once every N days.
# Set to 1 to crawl everything in one (very long) run.
CARTIER_ROTATION_DAYS=7

# Optional contact appended to the User-Agent so site owners can reach us,
# e.g. a URL. Leave empty to send the plain User-Agent.
CRAWL_CONTACT=https://github.com/HvH1110/Web_Project
