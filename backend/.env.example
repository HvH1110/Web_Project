# Copy to .env and fill in. .env is gitignored; never commit real values.

# Port the Express server listens on.
PORT=5000

# MongoDB Atlas connection string, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Leave empty to run without a database (/api/health then reports db "disconnected").
MONGODB_URI=

# Origin allowed by CORS (the Vite dev server locally). Non-GET requests from
# any other origin are refused (CSRF protection), so it must match exactly.
CLIENT_ORIGIN=http://localhost:5173

# Session cookie. Locally the defaults work (localhost:5173 and :5000 are the
# same site). In production set COOKIE_SECURE=true (HTTPS only). Use
# COOKIE_SAME_SITE=none only if the frontend and backend are on different
# sites; it implies Secure, and some browsers block such cookies anyway.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Number of proxies in front of the backend (e.g. 1 on most hosts), so rate
# limits see the real client IP. 0 when running directly, as locally.
TRUST_PROXY=0
