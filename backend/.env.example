# Copy to .env and fill in. .env is gitignored; never commit real values.

# Port the Express server listens on.
PORT=5000

# MongoDB Atlas connection string, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Leave empty to run without a database (/api/health then reports db "disconnected").
MONGODB_URI=

# Origin allowed by CORS (the Vite dev server locally).
CLIENT_ORIGIN=http://localhost:5173
