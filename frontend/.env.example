# Base URL of the backend API, including the /api prefix. No trailing slash.
VITE_API_URL=http://localhost:5000/api

# Optional, build time only: the site's public address, no trailing slash. Used
# for the share image and the sitemap line in robots.txt. On Vercel leave it
# unset: the production domain is picked up automatically.
# SITE_URL=https://example.com
